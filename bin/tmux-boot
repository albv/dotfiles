#!/bin/zsh
# Bring the tmux world up, restored, and settled — then print the real session
# list, one per line. The single "server is ready" primitive, called from two
# places at login, and safe when they overlap:
#   1. the LaunchAgent (macos/dev.dotfiles.tmux-boot.plist), so sessions are
#      restored even if WezTerm is never opened, and
#   2. WezTerm's gui-startup hook (wezterm.lua), which builds one tab per line
#      of our output.
# Starting the server sources ~/.tmux.conf → tpm → tmux-continuum, whose
# @continuum-restore rebuilds the last snapshot in the background. This replaces
# continuum's own macOS @continuum-boot, which pops open Apple Terminal.app.
#
# launchd runs with a minimal PATH, so the tmux path is absolute. NB: the
# variable is `tmux_bin`, not `TMUX` — `TMUX` is tmux's own special env var
# (socket,pid,session) and shadowing it would break every tmux child when this
# script is ever run from inside a tmux pane.
tmux_bin=/opt/homebrew/bin/tmux
export PATH="/opt/homebrew/bin:$PATH"

# Real sessions = everything except the throwaway bootstrap. `-n "$(grep -vx)"`
# rather than `grep -qvx`: BSD grep (what launchd's non-interactive shell gets)
# handles `-qv` fine, but ugrep — which is `grep` in an interactive shell here —
# returns the wrong exit status for `-q` + `-v`. This form is correct under both.
others() { "$tmux_bin" list-sessions -F '#S' 2>/dev/null | grep -vx _boot }

# Ensure a server exists so continuum's restore fires. Concurrency-safe: if one
# is already up (the LaunchAgent and gui-startup can land here at the same
# instant), don't disturb it — just fall through to the settle-wait below. A
# failing `list-sessions` means "no server yet". If two callers race here, one
# wins new-session and the other's duplicate simply errors out (harmless).
"$tmux_bin" list-sessions >/dev/null 2>&1 || "$tmux_bin" new-session -d -s _boot 2>/dev/null

# Wait (bounded) for continuum's background restore to finish, by watching for
# the sessions the snapshot says should exist (field 2 of its pane lines).
# Fast path: the moment every expected session is live we are settled — zero
# extra delay when the server was already up. Fallback: if some never appear
# (a snapshot listing a session killed without a save since), settle once the
# list is non-empty and unchanged across 5 polls. No snapshot, or one with no
# real sessions, means nothing will be restored — skip the wait entirely.
# Snapshot location mirrors resurrect's own resolution: legacy dir, then XDG.
snapshot_file() {
  local d
  for d in "$HOME/.tmux/resurrect" "${XDG_DATA_HOME:-$HOME/.local/share}/tmux/resurrect"; do
    [ -f "$d/last" ] && { print -r -- "$d/last"; return 0 }
  done
  return 1
}
want=''
f=$(snapshot_file) && want=$(awk -F'\t' '$1=="pane" && $2!="_boot" {print $2}' "$f" | sort -u)
# $1 = current session list; true when every wanted session is in it. Pure
# zsh line matching: BSD awk can't take multi-line -v strings, and session
# names may contain spaces, so no field splitting either.
settled() {
  local w
  for w in ${(f)want}; do
    [[ $'\n'"$1"$'\n' == *$'\n'"$w"$'\n'* ]] || return 1
  done
  return 0
}
# Continuum's restore fires exclusively at server start, so a server that has
# been up for a while finished restoring long ago — waiting would only stall
# (worst on an alive-but-empty server, where the fallback can never trigger).
# start_time is a server-level format; if it can't be read (no session to
# anchor display-message on), treat the server as old and skip the wait.
srv_start=$("$tmux_bin" display -p '#{start_time}' 2>/dev/null)
[ -n "$srv_start" ] || srv_start=0
age=$(( $(date +%s) - srv_start ))
if [ -n "$want" ] && [ "$age" -lt 60 ]; then
  prev='' stable=0
  for _ in {1..75}; do
    cur=$(others)
    settled "$cur" && break
    if [ -n "$cur" ] && [ "$cur" = "$prev" ]; then
      stable=$((stable + 1))
      [ "$stable" -ge 5 ] && break
    else
      stable=0
      prev=$cur
    fi
    sleep 0.2
  done
fi

# Reconcile before building tabs: a restored worktree session whose store
# directory no longer exists (removed by wt done/gc — a snapshot can outlive
# the teardown it missed) is a zombie pointing nowhere. Kill it so it neither
# gets a tab nor re-enters the next snapshot; the session-closed hook then
# persists the correction. Fail-safe by construction: reaping requires the
# store to EXIST (a missing/diverged store means we cannot judge — skip) AND
# the session's repo part to match a store repo we actually manage (so a
# non-wt session that merely contains '--' is never touched) AND no project
# directory to claim the name. Store path/munge rules mirror bin/wt.
WORKSPACE_DIR="${WORKSPACE_DIR:-$HOME/Workspace}"
STORE="$WORKSPACE_DIR/.worktrees"
if [ -d "$STORE" ]; then
  "$tmux_bin" list-sessions -F '#S' 2>/dev/null | grep -vx _boot | while IFS= read -r s; do
    case "$s" in
      *--*)
        ok=''
        for d in "$STORE"/*/*(/N); do
          [ "$(print -r -- "${d:h:t}" | tr '.:' '__')--${d:t}" = "$s" ] && { ok=1; break }
        done
        # a project directory whose name contains '--' is legitimate too
        # ((-/N): symlinked projects count, matching the picker's find -L)
        if [ -z "$ok" ]; then
          for d in "$WORKSPACE_DIR"/*(-/N); do
            [ "$(print -r -- "${d:t}" | tr '.:' '__')" = "$s" ] && { ok=1; break }
          done
        fi
        # only reap inside a known repo's namespace: <munged-repo>--…
        zombie=''
        if [ -z "$ok" ]; then
          for d in "$STORE"/*(/N); do
            case "$s" in
              "$(print -r -- "${d:t}" | tr '.:' '__')--"*) zombie=1; break ;;
            esac
          done
        fi
        [ -n "$zombie" ] && "$tmux_bin" kill-session -t "=$s" 2>/dev/null
        ;;
    esac
  done
fi

# Drop the bootstrap unconditionally: with exit-empty off the server survives
# at zero sessions, so _boot is pure scaffolding — keeping it around only
# pollutes snapshots and session lists.
"$tmux_bin" kill-session -t _boot 2>/dev/null

# Emit the settled real-session list for gui-startup to build tabs from. (The
# LaunchAgent ignores stdout.)
others
