#!/bin/zsh
# The single writer for resurrect snapshots. Fired by tmux hooks
# (session-created / session-closed / client-detached) via run-shell -b, so it
# always runs in the server's own environment — one context, one lock path.
# Debounces hook storms (a boot-time restore or a `wt gc` sweep fires many
# hooks within seconds) into one save, and serializes saves so two can never
# interleave or share resurrect's second-resolution snapshot filename.
# Continuum's timer is disabled (@continuum-save-interval 0): with every
# structural change saving through here, a timer adds nothing but races.
export PATH="/opt/homebrew/bin:$PATH"

save="$HOME/.tmux/plugins/tmux-resurrect/scripts/save.sh"
state="$HOME/.local/state/tmux-snapshot"
# Snapshot dir, resolved as resurrect does: @resurrect-dir (with ~/$HOME
# expanded), else the legacy ~/.tmux/resurrect if it exists, else XDG.
resdir=$(tmux show -gqv @resurrect-dir 2>/dev/null)
resdir=${${resdir//\$HOME/$HOME}//\~/$HOME}
[ -n "$resdir" ] || { resdir="$HOME/.tmux/resurrect"
  [ -d "$resdir" ] || resdir="${XDG_DATA_HOME:-$HOME/.local/share}/tmux/resurrect"; }
[ -x "$save" ] || exit 0
mkdir -p "$state"

# Mark work pending, then try to become the saver. Losing the race is fine:
# the current holder's dirty-loop below picks the mark up. (Residual window:
# a mark set between the holder's final dirty-check and its exit waits for
# the next hook event — client-detached fires often enough to heal it.)
: > "$state/dirty"

# Kernel lock, not a hand-rolled pidfile: flock is atomic and the kernel
# releases it when the holder dies — any way it dies, SIGKILL included — so
# stale locks and lock-stealing races cannot exist by construction.
zmodload zsh/system 2>/dev/null || exit 0
: >> "$state/lock"
zsystem flock -t 0 "$state/lock" 2>/dev/null || exit 0   # live holder exists

# A save only counts if it finished and the server outlived it. A server
# dying mid-save (shutdown SIGTERM, crash) leaves save.sh writing a partial
# snapshot — panes without windows, or none at all — and a truncated
# scrollback archive, both silently adopted by the next boot. So remember the
# good `last` target and a copy of the archive, and put both back when save.sh
# fails or the server is gone afterwards. The signal handler does the same for
# the SIGTERM path (zsh delivers the trap after the foreground save.sh
# returns); outside a save (saving unset) it is a no-op.
prev='' saving=''
distrust_dead_save() {
  [ -n "$saving" ] || return 0
  if [ -z "$prev" ]; then rm -f "$resdir/last"; return 0; fi   # first-ever save: no good one to keep
  ln -sfn "$prev" "$resdir/last" 2>/dev/null
  [ -f "$state/archive.prev" ] &&
    cp -p "$state/archive.prev" "$resdir/pane_contents.tar.gz" 2>/dev/null
}
# save.sh exits 0 even when a step inside it failed, so judge the result: a
# snapshot with panes needs its windows, and (with capture on) an archive
# that gunzips.
save_looks_whole() {
  [ -s "$resdir/last" ] || return 1
  grep -q '^pane' "$resdir/last" || return 0      # empty server: "state" only
  grep -q '^window' "$resdir/last" || return 1
  [ "$(tmux show -gqv @resurrect-capture-pane-contents)" = on ] || return 0
  gzip -t "$resdir/pane_contents.tar.gz" 2>/dev/null
}
trap 'distrust_dead_save; exit 143' TERM INT HUP

# Save once the hooks go quiet for 3s — but never postpone forever: under
# sustained fire (events < 3s apart) the deadline forces a save every ~30s.
rounds=0
while [ -e "$state/dirty" ]; do
  rm -f "$state/dirty"
  sleep 3
  if [ -e "$state/dirty" ] && [ $(( ++rounds )) -lt 10 ]; then
    continue                          # storm in progress — keep debouncing
  fi
  rounds=0
  tmux list-sessions >/dev/null 2>&1 || break   # server gone: nothing to save
  # Never save over a restore that hasn't happened. Until continuum's restore
  # sets TMUX_RESTORE_SETTLED, the server holds only _boot (or a half-built
  # restore) — saving it would repoint `last` and overwrite the archive before
  # restore even reads them. Young server: retry later. Older and still
  # unsettled (restore skipped or died) with zero sessions: drop the save —
  # an empty unsettled server must never replace a real snapshot. (Sessions
  # made by hand on such a server are real work and do get saved.)
  if ! tmux show-environment -g TMUX_RESTORE_SETTLED >/dev/null 2>&1; then
    start=$(tmux display -p '#{start_time}' 2>/dev/null)
    if [ $(( $(date +%s) - ${start:-0} )) -lt 60 ]; then
      : > "$state/dirty"; continue
    fi
    [ -n "$(tmux list-sessions -F x 2>/dev/null)" ] || continue
  fi
  prev=$(readlink "$resdir/last" 2>/dev/null) saving=1
  cp -p "$resdir/pane_contents.tar.gz" "$state/archive.prev" 2>/dev/null ||
    rm -f "$state/archive.prev"
  "$save" quiet >/dev/null 2>&1
  if [ $? -ne 0 ] || ! tmux list-sessions >/dev/null 2>&1 || ! save_looks_whole; then
    distrust_dead_save
  fi
  prev='' saving=''
done
exit 0
