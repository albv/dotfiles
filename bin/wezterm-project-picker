#!/bin/zsh
# New WezTerm tab entrypoint: pick a project, attach its tmux session.
# One tab = one project = one tmux session (persists after tab closes).
export PATH="$HOME/.local/bin:/opt/homebrew/bin:$PATH"

# Where projects live — override with WORKSPACE_DIR or edit here per machine
WORKSPACE_DIR="${WORKSPACE_DIR:-$HOME/Workspace}"
STORE="$WORKSPACE_DIR/.worktrees"

# Never let fzf block without a terminal (non-interactive invocation)
[ -t 0 ] || exec zsh

# Server down (first run, or it died mid-day): bring it up through tmux-boot
# so continuum's restore completes before we read or create sessions — a bare
# new-session below would race the restore
tmux list-sessions >/dev/null 2>&1 || tmux-boot >/dev/null 2>&1

command -v fzf >/dev/null 2>&1 || exec tmux new-session -A -s main

# _boot is tmux-boot's throwaway bootstrap, not a project — never list it
sessions=$(tmux list-sessions -F '#S' 2>/dev/null | grep -vx _boot)
# Project dirs: (-/) follows symlinks, so projects symlinked into the
# workspace root count too; sorted, and dot-dirs (.worktrees included) are
# skipped by default globbing
projs=( "$WORKSPACE_DIR"/*(-/N:t) )

# Grouped list: each project line (● live session, or bare dir without one)
# is followed by its worktrees indented beneath it — live sessions (●) first,
# then revivable orphans (⌥). Children match parents by munged name
# (. : -> _), the same rule session names are built with. Worktrees whose
# parent vanished entirely (no session, no project dir) fall to the bottom
# ungrouped, in their old full form. ctrl-o (not ctrl-w: that's fzf's default
# delete-word, and --expect would steal it from query typing).
# A session counts as a worktree session only when it exactly matches a store
# entry's (munged repo)--(slug) — whole-name comparison, the same rule wt's
# resolve_target uses. Never split on '--' positionally: a plain project that
# happens to contain '--' must stay a project, and a repo named with '--' must
# group its worktrees under itself, not under its first name segment.
typeset -A wt_parent orph_parent grouped
asessions=( ${(f)sessions} )
# One pass over the store: map every worktree's session name to its munged
# parent, and collect worktrees whose session died (reboot, closed tab) as
# revivable orphans — live worktree sessions are listed as ● instead
orphans=()
for d in "$STORE"/*/*(/N); do
  m=${${d:h:t}//[.:]/_}
  wt_parent[$m--${d:t}]=$m
  (( ${asessions[(Ie)$m--${d:t}]} )) || { orphans+=("${d:h:t}/${d:t}"); orph_parent[${d:h:t}/${d:t}]=$m }
done
psessions=(); wsessions=()
for s in $asessions; do
  if [[ -n ${wt_parent[$s]} ]]; then wsessions+=("$s"); else psessions+=("$s"); fi
done

list=()
add_children() {  # $1 = munged parent name; each child grouped at most once
  local s w
  for s in $wsessions; do
    [[ ${wt_parent[$s]} == "$1" && -z ${grouped[s$s]} ]] && { list+=("   └ ● $s"); grouped[s$s]=1 }
  done
  for w in $orphans; do
    [[ ${orph_parent[$w]} == "$1" && -z ${grouped[o$w]} ]] && { list+=("   └ ⌥ $w"); grouped[o$w]=1 }
  done
}
for s in $psessions; do list+=("● $s"); add_children "$s"; done
for p in $projs; do
  m=${p//[.:]/_}
  # dedupe against ALL sessions (as before grouping existed): a dir whose
  # munged name matches any live session keeps a single row, never two
  (( ${asessions[(Ie)$m]} )) && continue
  list+=("$p"); add_children "$m"
done
for s in $wsessions; do (( ${+grouped[s$s]} )) || list+=("● $s"); done
for w in $orphans; do (( ${+grouped[o$w]} )) || list+=("⌥ $w"); done

out=$(
  { (( ${#list} )) && printf '%s\n' "${list[@]}" } |
    fzf --prompt='project ▸ ' --height=100% --reverse \
        --expect=ctrl-o,ctrl-x \
        --header='enter attach · ctrl-o new worktree · ctrl-x remove worktree · Esc shell'
)

# --expect output is "key\nselection". An expect-key pressed with a
# non-matching query emits only the key line — no selection, nothing to do.
key=${out%%$'\n'*}
choice=${out#*$'\n'}
[[ $out == *$'\n'* ]] || choice=""
# Esc → shell; an expect-key with nothing selected → back to the picker
[ -z "$choice" ] && { [ -n "$key" ] && exec "$0"; exec zsh }
# grouped child rows carry an indent; shed it so every parse below sees the
# same ●/⌥-prefixed forms as before grouping existed
choice=${choice#'   └ '}

# Deterministic WezTerm tab title (immune to OSC title races)
settitle() {
  PATH="$PATH:/Applications/WezTerm.app/Contents/MacOS" \
    wezterm cli set-tab-title "$1" 2>/dev/null
}

# Show a wt error (already printed on stderr), wait, re-show the picker —
# friendlier than dumping into a bare shell. SELF, not $0: inside a zsh
# function $0 is the function name, and exec'ing that recurses forever.
SELF=$0
again() {
  printf 'press any key\n'
  read -k1 -s
  exec "$SELF"
}

# Session names are munged (. : -> _); find the real project directory by
# comparing munged basenames — the same rule the dedupe loop above uses.
# (-/N): match symlinked project dirs too, same as the find -L above
resolve_project() {
  [ -d "$WORKSPACE_DIR/$1" ] && { printf '%s' "$1"; return 0 }
  local p
  for p in "$WORKSPACE_DIR"/*(-/N); do
    if [ "${${p:t}//[.:]/_}" = "$1" ]; then
      printf '%s' "${p:t}"
      return 0
    fi
  done
  return 1
}

# Strip the ●/⌥ markers the picker itself added. (A directory literally
# named like "● foo" — or "   └ ● foo" now that children are indented — is
# listed unmarked yet still matches the marked patterns below and gets
# misrouted — accepted; don't name dirs that.)
entry=$choice
case "$entry" in
  "● "*) entry=${entry#● } ;;
  "⌥ "*) entry=${entry#⌥ } ;;
esac

case "$key" in
  ctrl-o)
    # target repo: orphan entries are repo/slug, worktree sessions are
    # repo--slug (resolve via the store), anything else is a project name
    proj=''
    case "$entry" in
      */*) proj=$(resolve_project "${entry%%/*}") ;;
      *)
        proj=$(resolve_project "$entry")
        if [ -z "$proj" ] && [[ "$entry" == *--* ]]; then
          for d in "$STORE"/*/*(/N); do
            if [ "${${d:h:t}//[.:]/_}--${d:t}" = "$entry" ]; then
              proj=$(resolve_project "${d:h:t}")
              break
            fi
          done
        fi
        ;;
    esac
    [ -n "$proj" ] || { printf 'no project directory for "%s"\n' "$entry"; again }
    pdir="$WORKSPACE_DIR/$proj"
    # Branch fzf: existing branches (local + origin, deduped) minus any
    # checked out somewhere — git refuses those, and branches in managed
    # worktrees are already ●/⌥ entries in the main list. Enter attaches the
    # highlighted branch; once the list is empty (nothing matches) Enter
    # creates the typed name. Accepted limitation, by choice: a new name
    # that fuzzy-matches an existing branch ("wip" vs "swipe-fix") never
    # empties the list, so create it with `wt new` from a shell instead.
    # No fetch here — ctrl-o stays instant; wt new freshens the chosen ref.
    used=( ${(f)"$(git -C "$pdir" worktree list --porcelain 2>/dev/null |
                   awk '$1=="branch"{sub("refs/heads/","",$2); print $2}')"} )
    cand=( ${(f)"$( {
        git -C "$pdir" branch --format='%(refname:short)'
        git -C "$pdir" branch -r --format='%(refname:short)' |
          sed -n 's|^origin/||p' | grep -vx HEAD
      } 2>/dev/null | sort -u )"} )
    cand=( ${cand:|used} )
    out=$( { (( ${#cand} )) && printf '%s\n' "${cand[@]}" } |
      fzf --prompt="branch for $proj ▸ " --height=100% --reverse --print-query \
          --header='enter pick branch · no match → enter creates typed name · Esc back' )
    # fzf exits 0 (match) / 1 (no match: query only) / 2 (error) / 130 (Esc,
    # ctrl-c) — anything ≥2 goes back to the picker.
    [ $? -ge 2 ] && exec "$SELF"
    # --print-query emits "query\nselection"; the last line is the selection
    # when one matched, otherwise the typed query = the new branch's name
    branch=${out##*$'\n'}
    [ -z "$branch" ] && exec "$SELF"
    if name=$(wt new --no-attach --repo "$pdir" "$branch"); then
      settitle "$name"
      exec tmux attach -t "=$name"
    fi
    again
    ;;
  ctrl-x)
    # wt resolves repo/slug and repo--slug forms itself and politely
    # refuses anything that isn't a managed worktree
    wt done "$entry"
    again
    ;;
esac

# Enter — attach-or-create
case "$choice" in
  "● "*)
    settitle "$entry"
    exec tmux new-session -A -s "$entry"
    ;;
  "⌥ "*)
    if name=$(wt open --no-attach "${entry%%/*}" "${entry#*/}"); then
      settitle "$name"
      exec tmux attach -t "=$name"
    fi
    again
    ;;
esac

name=${choice//[.:]/_}
dir="$WORKSPACE_DIR/$choice"
[ -d "$dir" ] || dir="$HOME"

# First creation gets the dev layout; reattach never re-applies it.
# A project can override with an executable .session-setup script, which
# runs inside the session's first pane (plain tmux commands work there).
if ! tmux has-session -t "=$name" 2>/dev/null; then
  tmux new-session -d -s "$name" -c "$dir"
  # (qq): single-quote — send-keys types this into the pane's interactive
  # shell, where a bare ' would hang at a continuation prompt and a bare !
  # trips history expansion ((q) leaves ! unescaped)
  if [ -x "$dir/.session-setup" ]; then
    tmux send-keys -t "=$name:" "${(qq)dir}/.session-setup" Enter
  else
    tmux split-window -h -l 30% -t "=$name:" -c "$dir"
    tmux select-pane -t "=$name:.1"
  fi
fi
settitle "$name"
exec tmux attach -t "=$name"
