#!/bin/zsh
# wt — sweep git worktrees whose work has landed. Creating and opening
# worktrees is Herdr's job (`herdr worktree create`, prefix+shift+g), and it
# stores them where this looks: $WORKSPACE_DIR/.worktrees/<repo>/<branch-slug>
# (herdr/config.toml sets [worktrees] directory to match). The one thing Herdr
# lacks is "remove the ones that merged", which is all that's left here.
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

WORKSPACE_DIR="${WORKSPACE_DIR:-$HOME/Workspace}"
STORE="$WORKSPACE_DIR/.worktrees"

die() { print -u2 "wt: $*"; exit 1 }

# Primary clone path — correct even when asked from inside another worktree
# (--show-toplevel would return the worktree itself)
primary_root() {
  local g
  g=$(git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
  print -r -- "${g%/.git}"
}

# Default branch: origin/HEAD if set locally, else main, else master.
# Never runs `remote set-head` — detection must not mutate the repo.
base_branch() {
  local b
  b=$(git -C "$1" symbolic-ref -q --short refs/remotes/origin/HEAD) && { print -r -- "${b#origin/}"; return 0 }
  git -C "$1" show-ref -q --verify refs/heads/main && { print -r -- main; return 0 }
  git -C "$1" show-ref -q --verify refs/heads/master && { print -r -- master; return 0 }
  return 1
}

# Has this branch's work landed on the base? Three detectors, all failing
# safe toward "keep".
is_landed() {
  local wt_path=$1 branch=$2 base=$3 root=$4 upstream pr tip mb synth
  # Detached worktrees pass an empty branch; a bare HEAD in the -C "$root"
  # checks below would resolve in the PRIMARY clone (usually sitting on the
  # base branch) and pass trivially — destroying unmerged commits. Detached
  # state is unverifiable here: never "landed".
  [ -n "$branch" ] || return 1
  # refs/heads/ spelled out: a same-named tag would otherwise win resolution
  local ref="refs/heads/$branch"
  if git -C "$root" show-ref -q --verify "refs/remotes/origin/$base"; then
    upstream="origin/$base"
  else
    upstream="$base"
  fi
  # (a) a merged PR for this exact tip. The OID equality guard matters:
  # branch names get reused, and gh returns the most recent PR for a head
  # branch *including old merged ones* — without it gc would eat fresh work.
  if command -v gh >/dev/null 2>&1; then
    pr=$(cd "$wt_path" 2>/dev/null && gh pr view "$branch" --json state,headRefOid \
         --jq '.state + " " + .headRefOid' 2>/dev/null)
    tip=$(git -C "$wt_path" rev-parse HEAD 2>/dev/null)
    [ "$pr" = "MERGED $tip" ] && return 0
  fi
  # (b) regular merge: branch tip reachable from upstream
  git -C "$root" merge-base --is-ancestor "$ref" "$upstream" 2>/dev/null && return 0
  # (c) squash merge: collapse the branch into one synthetic commit and ask
  # git-cherry whether an equivalent patch already exists upstream ("-").
  # The throwaway commit is an unreachable object; gc cleans it up.
  mb=$(git -C "$root" merge-base "$upstream" "$ref" 2>/dev/null) || return 1
  synth=$(git -C "$root" commit-tree "$ref^{tree}" -p "$mb" -m _ 2>/dev/null) || return 1
  [ "$(git -C "$root" cherry "$upstream" "$synth" 2>/dev/null)" = "- $synth" ]
}

# Print the id of the Herdr workspace that has this worktree open; print
# nothing when none does, Herdr isn't installed, or no server is running.
# Fails closed: any other trouble asking Herdr returns non-zero, so the
# caller skips the worktree instead of deleting a checkout that may be open.
# Herdr reports git's resolved paths, hence :A on ours.
herdr_workspace() {
  local wt_path=${1:A} root=$2 out
  command -v herdr >/dev/null 2>&1 || return 0
  if out=$(herdr worktree list --cwd "$root" 2>&1); then
    print -r -- "$out" | jq -er --arg p "$wt_path" '
      .result.worktrees | if type == "array" then . else error("no worktree list") end
      | map(select(.path == $p))[0].open_workspace_id // ""' 2>/dev/null
  else
    print -r -- "$out" | jq -e '.error.code == "server_not_running"' >/dev/null 2>&1
  fi
}

# A workspace's sidebar label, for messages (falls back to the id)
workspace_label() {
  local label
  label=$(herdr workspace list 2>/dev/null |
    jq -r --arg id "$1" '.result.workspaces[]? | select(.workspace_id == $id) | .label' 2>/dev/null)
  print -r -- "${label:-$1}"
}

# Remove worktree + branch (+ its Herdr workspace). Every git op is anchored
# to the primary root with absolute paths: `worktree remove` happily deletes
# the directory this script is standing in, and any bare git command
# afterwards dies on the deleted cwd.
teardown() {
  local wt_path=$1 root repo s branch ws err
  case "$wt_path" in
    "$STORE"/*/*) ;;
    *) die "refusing: $wt_path is not under $STORE" ;;
  esac
  root=$(primary_root "$wt_path") || die "not a git worktree: $wt_path"
  [ "$root" = "$wt_path" ] && die "refusing to remove a primary clone"
  s=${wt_path:t}; repo=${wt_path:h:t}
  branch=$(git -C "$wt_path" branch --show-current 2>/dev/null)   # empty if detached: nothing to delete

  if ! ws=$(herdr_workspace "$wt_path" "$root"); then
    print -u2 "wt: skip $repo/$s: couldn't ask Herdr whether it's open"
    return 1
  fi
  if [ -n "$ws" ]; then
    # closing the workspace we're running in would kill this very script
    if [ "$ws" = "${HERDR_WORKSPACE_ID:-}" ]; then
      print -u2 "wt: skip $repo/$s: this shell is inside it; run gc from another workspace"
      return 1
    fi
    # Removes the checkout and closes its workspace; the branch stays. Herdr
    # only does this for workspaces it created as worktrees, and refuses one
    # that merely has a shell cd'd in here: leave that for the user to close.
    if ! err=$(herdr worktree remove --workspace "$ws" 2>&1 >/dev/null); then
      err=$(print -r -- "$err" | jq -r '.error.message // empty' 2>/dev/null)
      print -u2 "wt: skip $repo/$s: open in Herdr workspace \"$(workspace_label "$ws")\"${err:+ ($err)}; close it, then re-run"
      return 1
    fi
  else
    git -C "$root" worktree remove "$wt_path" || return 1
  fi
  if [ -n "$branch" ]; then
    # -D is only reached when landed (squash merges aren't ancestors,
    # so -d refuses them even though the work is upstream)
    git -C "$root" branch -d "$branch" 2>/dev/null ||
      git -C "$root" branch -D "$branch" ||
      print -u2 "wt: couldn't delete branch $branch"
  fi
  rmdir "$STORE/$repo" "$STORE" 2>/dev/null
  print -r -- "removed $repo/$s"
  return 0
}

cmd_gc() {
  local dry='' all='' d root branch base
  typeset -A seen
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) dry=1; shift ;;
      --all) all=1; shift ;;
      *) die "unknown flag for gc: $1" ;;
    esac
  done
  for d in "$STORE"/*/*(/N); do
    root=$(primary_root "$d") || { print "skip (broken)  ${d:h:t}/${d:t}"; continue }
    # once per repo: prune stale worktree metadata, refresh remote state
    # (assoc array, not substring matching — paths can contain spaces)
    if [ -z "${seen[$root]}" ]; then
      seen[$root]=1
      git -C "$root" worktree prune 2>/dev/null
      git -C "$root" fetch --quiet origin 2>/dev/null
    fi
    # dirty worktrees are untouchable, --all included
    if [ -n "$(git -C "$d" status --porcelain 2>/dev/null)" ]; then
      print "skip (dirty)   ${d:h:t}/${d:t}"
      continue
    fi
    branch=$(git -C "$d" branch --show-current 2>/dev/null)
    base=$(base_branch "$root") || { print "keep           ${d:h:t}/${d:t} (no base branch)"; continue }
    if ! is_landed "$d" "$branch" "$base" "$root"; then
      print "keep           ${d:h:t}/${d:t} (${branch:-detached})"
      continue
    fi
    if [ -n "$dry" ]; then
      print "would remove   ${d:h:t}/${d:t} ($branch, merged)"
    elif [ -n "$all" ]; then
      teardown "$d"
    else
      if read -q "?remove ${d:h:t}/${d:t} ($branch, merged)? [y/N] "; then
        print
        teardown "$d"
      else
        print
      fi
    fi
  done
}

usage() {
  cat <<EOF
wt — sweep merged worktrees under $STORE/<repo>/<slug>

  wt gc [--dry-run|--all]  remove worktrees whose work landed on the base
                       branch (merged PR / ancestry / squash detection),
                       with their branch and any Herdr workspace showing
                       them; asks per worktree unless --all. Dirty ones are
                       never touched.
  wt help              this text

Create and open worktrees with Herdr: \`herdr worktree create\` or prefix+shift+g.
EOF
}

case "$1" in
  gc)   shift; cmd_gc "$@" ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 1 ;;
esac
